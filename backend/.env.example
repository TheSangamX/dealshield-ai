# Copy to .env and fill in. Never commit .env.

PORT=3000

# Groq (get a key at https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# low | medium | high: high is slower (12-50s) without clearly better results
GROQ_REASONING_EFFORT=medium
# Fact-check pass that rewrites invented claims into [placeholders]. Doubles Groq calls and tokens.
VERIFY_DRAFTS=true


# Supabase → Project Settings → API. The service role key bypasses RLS: server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Analyses per month on the Free plan (Pro is unlimited)
FREE_MONTHLY_ANALYSES=10

# Comma-separated browser origins allowed by CORS (empty = allow all, dev only).
# The extension's background worker isn't restricted by CORS.
ALLOWED_ORIGINS=http://localhost:5173
