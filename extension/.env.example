# Copy to .env and fill in. VITE_* values are bundled into the extension and are PUBLIC.
# Never put secret keys (Gemini, Supabase service role) here.

# Backend base URL. If you change it, also add it to host_permissions in public/manifest.json.
VITE_API_URL=http://localhost:3000

# Supabase project (anon key only)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
