# Copy to .env and fill in. VITE_* values are bundled into the extension and are PUBLIC.
# Never put secret keys (Groq, Supabase service role, Razorpay) here.

# Backend base URL. The build adds its origin to host_permissions in dist/manifest.json.
VITE_API_URL=http://localhost:3000

# Supabase project (anon key only)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
